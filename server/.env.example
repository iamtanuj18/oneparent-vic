# OneParent VIC - Server Environment Configuration
# Copy this file to .env.local and fill in your actual values

# Server Configuration
NODE_ENV=development
API_ENV=local
PORT=5000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@localhost:5432/oneparent_vic
PG_POOL_MAX=5

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Google Gemini AI API Keys (multi-key pool for rate limit distribution)
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY_4=your_gemini_api_key_4
GEMINI_API_KEY_5=your_gemini_api_key_5
GEMINI_API_KEY_6=your_gemini_api_key_6
GEMINI_API_KEY_7=your_gemini_api_key_7
GEMINI_API_KEY_8=your_gemini_api_key_8
GEMINI_API_KEY_9=your_gemini_api_key_9
GEMINI_API_KEY_10=your_gemini_api_key_10

# Gemini Model Configuration (optional - defaults provided)
GEMINI_PRO_MODEL=models/gemini-2.5-pro
GEMINI_STANDARD_MODEL=models/gemini-2.5-flash
GEMINI_PRO_FALLBACK=models/gemini-2.5-flash-lite
GEMINI_STANDARD_FALLBACK=models/gemini-2.0-flash

# External API Keys
TICKETMASTER_KEY=your_ticketmaster_api_key
EVENTFINDA_USERNAME=your_eventfinda_username
EVENTFINDA_PASSWORD=your_eventfinda_password
EVENTFINDA_BASE=https://api.eventfinda.com.au/v2
