# AWS Redis Deployment - Ignore Sensitive Files

# Environment Files
.env
.env.*
*.env
redis.env

# Redis Connection Details
redis-connection-details.txt
connection-details.txt
redis-credentials.txt

# Redis Configuration Files (if containing passwords)
redis.conf
redis-server.conf

# SSH Keys
*.pem
*.key
*.ppk

# Redis Data Files
dump.rdb
appendonly.aof
*.rdb
*.aof

# Log Files
*.log
logs/
redis.log
redis-server.log

# AWS CloudFormation Outputs
stack-outputs.json
redis-outputs.json

# Temporary Files
*.tmp
*.temp
temp/
tmp/

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# Backup Files
*.bak
*.backup
*.old
*.orig

# Docker Compose Override Files
docker-compose.override.yml
docker-compose.prod.yml